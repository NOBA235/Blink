{
  "expo": {
    "name": "Blink",
    "slug": "blink-native",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blink",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.popnative"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B0E"
      },
      "package": "com.yourcompany.popnative"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pop uses your photos to let you add a profile picture."
        }
      ],
      "expo-audio",
      "expo-status-bar"
    ],
    "extra": {
      "router": {}
    }
  }
}
