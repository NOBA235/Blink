# Copy this file to .env and fill in your project's real values — find them
# in your Supabase project at Settings → API.
#
# Expo's equivalent of Vite's VITE_ prefix is EXPO_PUBLIC_ — anything with
# this prefix gets bundled into the app binary/JS bundle, same "safe to
# expose" rule as the web app's .env.example: these two are meant to be
# public. The Gemini key is NOT here for the same reason as the web app —
# it's a Supabase Edge Function secret, set once with
# `supabase secrets set GEMINI_API_KEY=...` and shared by both the web and
# native apps automatically, since they call the same Supabase project.
#
# Naming note: Supabase is mid-transition from "anon key" to "publishable
# key" as the name for this same value (Settings → API shows both names
# during the transition) — same key, just a renamed label.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
