# Copy this file to .env and fill in your project's real values — find them
# in your Supabase project at Settings → API.
#
# Expo's equivalent of Vite's VITE_ prefix is EXPO_PUBLIC_ — anything with
# this prefix gets bundled into the app binary/JS bundle, same "safe to
# expose" rule as the web app's .env.example: these two are meant to be
# public. The Gemini key is NOT here — never put it in this file. The AI
# host runs as a Supabase Edge Function (generate-host-line) using
# gemini-3.5-flash. Set the key once on the project:
#
#   npx supabase login
#   npx supabase link --project-ref YOUR-PROJECT-REF
#   npx supabase secrets set GEMINI_API_KEY=your-google-ai-studio-key
#   npx supabase functions deploy generate-host-line
#
# Then, in the Supabase SQL editor, point the host trigger at that function
# (service role key, not the anon/publishable key):
#
#   alter database postgres set app.settings.host_webhook_url =
#     'https://YOUR-PROJECT-REF.supabase.co/functions/v1/generate-host-line';
#   alter database postgres set app.settings.service_role_key =
#     'YOUR-SERVICE-ROLE-KEY';
#
# Naming note: Supabase is mid-transition from "anon key" to "publishable
# key" as the name for this same value (Settings → API shows both names
# during the transition) — same key, just a renamed label.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
